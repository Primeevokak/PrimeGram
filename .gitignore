# Python bytecode from the plugin SDK: written next to the sources whenever anything imports
# them, and nothing in the build reads it — Chaquopy compiles its own copy into the APK.
__pycache__/
*.py[cod]

# A separate, unrelated git checkout (its own .git, its own remote: Flowseal/tg-ws-proxy) kept
# here only as a local reference for the desktop counterpart of TgWsProxyService — not part of
# this repo's history, not a submodule. Without this line it shows up as one big untracked entry
# in git status, and some autosave hook was independently committing inside it too.
/tg-ws-proxy-repo/

# Same deal: a separate, unrelated git checkout (its own .git, its own remote: confeden/Novagram)
# kept only as a local reference, not part of this repo's history, not a submodule.
/novagram-repo/

# Same deal: namida (namidaco/namida), a real Flutter music player, kept as a local
# reference for the custom Music tab's UI/architecture - not a submodule.
/namida-repo/

# Same deal: yandex-music-api (MarshalX/yandex-music-api), an unofficial Yandex Music
# API client, kept as a local reference for the Music tab - not a submodule.
/yandex-music-api-repo/

# Screenshots/icons/images pulled from a Figma community file (real Yandex Music UI) via
# the Figma MCP, kept as a local design reference for the Music tab rewrite - not our own
# assets, not licensed for the app itself, never meant to be committed.
/figma-yandex-music-ref/

.agents/

TMessagesProj/jni/ffmpeg/build_android

# Decompiled third-party plugins (tools/plugin_decompiler) - never commit these
Tools/plugin_decompiler/out/
tools/plugin_decompiler/out/

# Release re-signing with key rotation (old + own key). Kept local; secrets it reads live in
# local.properties and outside the repo anyway.
/Tools/sign_release_rotated.sh

